generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  nickname      String?
  goals         Int            @default(0)
  assists       Int            @default(0)
  season        String         @default("24/25")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String?        @unique
  Fine          Fine[]
  user          User?          @relation(fields: [userId], references: [id])
  seasonStats   SeasonStats[]
  seasonPlayers SeasonPlayer[]
  corveeTeams   CorveeTeams[]
}

model SeasonPlayer {
  id        Int      @id @default(autoincrement())
  playerId  Int
  season    String
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season])
  @@index([season])
}

model SeasonStats {
  id        Int      @id @default(autoincrement())
  playerId  Int
  season    String
  goals     Int      @default(0)
  assists   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  player        Player?
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model FineInformation {
  id               Int      @id @default(autoincrement())
  fine_type        String   @unique(map: "sqlite_autoindex_FineInformation_1")
  fine_amount      Int      @default(0)
  fine_description String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  fines            Fine[]

  @@map("FineInformation")
}

model Fine {
  id                 Int             @id @default(autoincrement())
  fine_type_id       Int
  fine_amount        Int             @default(0)
  fine_amount_repaid Int             @default(0)
  active             Boolean         @default(true)
  player_id          Int
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  player             Player          @relation(fields: [player_id], references: [id], onDelete: Cascade)
  fineInfo           FineInformation @relation(fields: [fine_type_id], references: [id], onDelete: Cascade)

  @@map("Fines")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CorveeTeams {
  id          Int      @id @default(autoincrement())
  season      String
  team_letter String
  playerId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([season, team_letter, playerId])
  @@index([season, team_letter])
}

model CorveePlanning {
  id          Int      @id @default(autoincrement())
  season      String
  team_letter String
  year        Int
  week        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model GalleryAlbum {
  id          Int            @id @default(autoincrement())
  title       String?
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  photos      GalleryPhoto[]
}

model GalleryPhoto {
  id           Int          @id @default(autoincrement())
  albumId      Int
  filename     String
  originalName String?
  description  String?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  album        GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
}
